# Copia este archivo como .env y reemplaza los valores.
# El archivo .env está en el .gitignore: nunca se sube al repositorio.

# Contraseña del PostgreSQL que crea compose (no es la de tu PostgreSQL local)
POSTGRES_PASSWORD=cambia_esta_contraseña

# Clave para firmar los JWT: al menos 32 bytes aleatorios.
# Puedes generarla con: openssl rand -base64 48
JWT_CLAVE=reemplaza_con_una_clave_aleatoria_de_al_menos_32_bytes

# Administrador que se crea al iniciar con la tabla de usuarios vacía
ADMIN_EMAIL=admin@ferreapi.local
ADMIN_PASSWORD=cambia_esta_contraseña
